# BanglaGov-LLM settings. Copy this file to ".env" and fill in what you need.
# Every setting is optional: without any, the system runs with built-in answers
# and keyword search, and the admin page is off.

# --- Server -----------------------------------------------------------------
PORT=3000
# HOST=0.0.0.0                 # 127.0.0.1 = only this computer can open the site
# BANGLAGOV_RATE_LIMIT_PER_MIN=30
# BANGLAGOV_TRUST_PROXY=1      # set when running behind nginx/IIS so client IPs are correct
# BANGLAGOV_CORS_ORIGIN=       # only if another website must call the API

# --- Admin page (/admin.html) and crawling from the web page -------------------
# Use a long random value (at least 12 characters). Keep it secret.
BANGLAGOV_ADMIN_TOKEN=

# --- AI model (any OpenAI-compatible chat endpoint) ---------------------------
# Local and free with Ollama (https://ollama.com):  ollama pull qwen2.5:7b
# BANGLAGOV_LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
# BANGLAGOV_MODEL_NAME=qwen2.5:7b
# BANGLAGOV_LLM_KEY=           # API key, only for hosted providers
# BANGLAGOV_LLM_TIMEOUT_MS=90000
# BANGLAGOV_LLM_TEMPERATURE=0.1

# --- Semantic search (any OpenAI-compatible embeddings endpoint) ---------------
# Local and free with Ollama:  ollama pull bge-m3
# BANGLAGOV_EMBED_ENDPOINT=http://localhost:11434/v1/embeddings
# BANGLAGOV_EMBED_MODEL=bge-m3
# BANGLAGOV_EMBED_KEY=
# BANGLAGOV_EMBED_MIN_SCORE=0.5   # raise if unrelated pages appear, lower if good ones are missed

# --- Crawler ------------------------------------------------------------------
# CRAWLER_MAX_PAGES=40
# CRAWLER_DEPTH=2
# CRAWLER_DELAY_MS=1000
# CRAWLER_USE_BROWSER=0          # never use the headless browser (needs: npm install playwright)
# CRAWLER_ALLOW_INSECURE_TLS=1   # accept expired HTTPS certificates on *.gov.bd (weakens security)

# --- Database -----------------------------------------------------------------
# BANGLAGOV_DB_PATH=data/banglagov.db
